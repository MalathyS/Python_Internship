cat > .gitignore <<'EOF'
# Secrets and local configuration
.env
.env.*
!.env.example
!.env.sample

# Python virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Local logs and databases
*.log
*.sqlite
*.sqlite3

# Editors and operating system
.DS_Store
.vscode/
.idea/
EOF